# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel


# typescript
*.tsbuildinfo
next-env.d.ts
local-*
.claude
.z-ai-config
*.log
dev.log
dev.out.log
test
prompt

server.log
# Skills directory
/skills/

# Ranked history (ungzipped — only .gz versions are committed to repo)
# sync-ranked.js regénère ces fichiers à chaque run ; les versions non-gzippées
# ne sont pas nécessaires sur le site (seul le .gz est servi). Les ignorer évite
# qu'ils bloquent git pull --rebase avec "unstaged changes".
/ranked_history.json
/ranked_2v2_history.json

# Backups (ne jamais commit)
*backup.json
*full.json
# Temp files from agent tools (never commit)
/tool-results/
dashboard-*-screenshot.png
dashboard-v[0-9]-*.png
live-*-final.png

# All dashboard screenshots (never commit)
dashboard-*.png

# ─── Build artifacts ──────────────────────────────────────────────────────────
# /dist/ IS committed because GitHub Pages doesn't run a build step.
# The minified bundles must be present in the repo so they get deployed.
# Run `node scripts/build.js` after editing source JS to regenerate them.

# Build deps (local only — don't commit our local symlink or package-lock)
/node_modules
/package-lock.json

# Build script temp
/scripts/build.js.bak

# NOTE: Heavy sync state files (runs.json.gz, seen.json, seen_compact.json,
# runs_compact.json.gz, teams_runs.json, teams_seen.json, checkpoint*.json,
# player-data/) are KEPT in git so the GitHub Actions sync workflow can
# resume from where it left off (otherwise it would have to re-scrape
# 400 days of history from scratch, taking hours).
# See GUIDE_NETTOYAGE.md for the rationale.
